# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# ─── Application ──────────────────────────────────────────────────────────────
# Secret used to sign application JWTs and the short-lived OAuth state cookie.
# Generate one with: openssl rand -hex 32
APP_SECRET=replace-with-a-long-random-secret
PORT=3000

# ─── Tokens ───────────────────────────────────────────────────────────────────
# Access token lifetime. Kept short because it cannot be revoked once signed —
# revocation is the refresh token's job.
ACCESS_TOKEN_TTL=15m
# How long a refresh token family survives before requiring a fresh login.
REFRESH_TOKEN_TTL_DAYS=30
# Window after a refresh token is rotated during which presenting it again is
# treated as a concurrent request rather than a stolen token.
REFRESH_REUSE_GRACE_SECONDS=10

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-me
DB_NAME=clothing_store

# ─── Google Sign-In (OpenID Connect) ──────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (type: Web application). GOOGLE_CALLBACK_URL must be listed there verbatim as
# an "Authorized redirect URI".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Facebook Login (Meta) ────────────────────────────────────────────────────
# developers.facebook.com -> your app -> Facebook Login -> Settings.
# FACEBOOK_CALLBACK_URL must be listed under "Valid OAuth Redirect URIs", and
# the app needs the `email` permission to link accounts by email.
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback
# Graph API version used for the token exchange and profile lookup.
FACEBOOK_GRAPH_VERSION=v21.0

# ─── API documentation ────────────────────────────────────────────────────────
# Serves interactive Swagger UI at SWAGGER_PATH. Defaults to on outside
# production; publishing the full API surface should be a deliberate choice.
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API. Comma-separated for more than one.
# Must be exact origins — CORS with credentials forbids a "*" wildcard, and
# without this the frontend cannot call POST /auth/refresh.
FRONTEND_ORIGIN=http://localhost:5173
# Where the OAuth redirect flows send the browser once a session exists. No
# token in the URL: the app calls POST /auth/refresh on landing.
FRONTEND_POST_LOGIN_URL=http://localhost:5173/auth/callback
